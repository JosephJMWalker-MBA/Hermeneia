+// Ratify & Save commits the exact previewed Blueprint through the human approval boundary (#251 R5).
+async function obRatifyPreviewed() {
+  const propEl = document.getElementById('ob-extract-proposal');
+  const reviewed = _obPreviewedBlueprint;
+  if (!propEl || !reviewed) return;
+  try {
+    const resp = await fetch('/api/pipeline/ratify-blueprint', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({ proposed_blueprint: reviewed }),
+    });
+    const data = await resp.json();
+    if (!resp.ok) {
+      propEl.innerHTML = _obExtractProposalHtml(reviewed, 'preview')
+        + `<div style="color:#f87171;font-size:13px">✗ ${x(data.error || 'Ratification failed')}</div>`;
+      return;
+    }
+    _obPreviewedBlueprint = null;
+    propEl.innerHTML = _obExtractProposalHtml(data.committed_blueprint || reviewed, 'saved');
