+function _e10ArchitectProposalHtml(candidate, note) {
+  const bp = candidate.proposal.blueprint;
+  const view = candidate.binding.view;
+  const labels = Object.fromEntries([...view.observations, ...view.interpretations].map(e => [e.id, e.label]));
+  const sections = bp.sections.map((s, i) => {
+    const cited = [...s.supporting_observations, ...s.supporting_interpretations].map(id => labels[id] || id).join(', ');
+    const tag = cited ? ' <span style="color:var(--dim2);font-size:11px">[' + x(cited) + ']</span>' : '';
+    return '<div style="margin:4px 0"><span style="color:var(--dim2)">' + (i + 1) + '.</span> ' + x(s.claim) + tag + '</div>';
+  }).join('');
+  const warning = note ? '<div style="color:var(--red);margin-top:6px">' + note + '</div>' : '';
+  return `<div class="arc-proposal">
+      <div style="font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim2)">Model proposal — nothing saved yet</div>
+      <div style="font-weight:600;margin-top:4px">${x(bp.title)}</div>
+      <div style="font-style:italic;margin:4px 0">"${x(bp.thesis)}"</div>
+      ${sections}
+      <div style="font-size:11px;color:var(--dim2);margin-top:6px">Proposed by ${x(candidate.extraction.execution.model_id)}. Accepting records this exact proposal and its provenance; it does not make the claims true.</div>
+      <div style="margin-top:8px">
+        <button class="btn-primary" onclick="e10AcceptArchitectProposal()">Accept exactly →</button>
+        <button class="btn-trace" onclick="e10DiscardArchitectProposal()">Discard</button>
+      </div>
+      ${warning}
+    </div>`;
+}
